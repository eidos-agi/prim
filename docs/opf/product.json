    {
      "id": "opf:prim:decision:profile-internal-sdk",
      "type": "decision",
      "title": "Each Prim type has an internal SDK; none reimplements the category kernel",
      "status": "active",
      "provenance": {
        "by": "human:daniel",
        "method": "Accepted in ARP cockpit session 2026-08-19: each Prim type needs its own internal SDK; none reimplements the category kernel."
      },
      "description": "Agree on a per-type SDK for domain operations and gates. Disagree that each type needs its own pack kernel.",
      "content": "content/sdk-split.md",
      "rationale": {
        "why": "Domain verbs are not interchangeable, and pack/zip/face already had three copies. Split the kernel from the type SDK so a new type is a plugin, not a host change.",
        "problems": [
          "opf:prim:problem:copied-pack-code",
          "opf:prim:problem:kernel-type-switch"
        ],
        "alternatives": [
          {
            "option": "One mega SDK with every domain type in the kernel",
            "disposition": "ruled-out",
            "reason": "That is a type switch. Category SDK README: nothing profile-specific belongs here."
          },
          {
            "option": "Kernel only; no profile SDK",
            "disposition": "ruled-out",
            "reason": "OMF import and docket task-create are different jobs. Face-only types register a validator and stop; they do not need an SDK yet."
          }
        ],
        "revisit_when": [
          "A profile SDK reimplements zip or face parse.",
          "The category SDK grows a type switch.",
          "A new type ships an SDK before it has domain verbs."
        ]
      }
    },
