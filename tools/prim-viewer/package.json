{
  "name": "@eidos-agi/prim-viewer",
  "version": "0.1.2",
  "type": "module",
  "description": "Flash for .prim files — <show-prim> plus React and Next components. WebMCP on the same tag.",
  "main": "./showprim.js",
  "types": "./showprim.d.ts",
  "exports": {
    ".": {
      "types": "./showprim.d.ts",
      "default": "./showprim.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./next": {
      "types": "./next.d.ts",
      "default": "./next.js"
    },
    "./webmcp": {
      "types": "./webmcp.d.ts",
      "default": "./webmcp.js"
    },
    "./showprim.js": "./showprim.js",
    "./package.json": "./package.json"
  },
  "files": [
    "showprim.js",
    "showprim.d.ts",
    "react.js",
    "react.d.ts",
    "next.js",
    "next.d.ts",
    "webmcp.js",
    "webmcp.d.ts",
    "README.md"
  ],
  "sideEffects": [
    "./showprim.js",
    "./react.js",
    "./next.js",
    "./webmcp.js"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidos-agi/prim.git",
    "directory": "tools/prim-viewer"
  },
  "homepage": "https://github.com/eidos-agi/prim/tree/main/tools/prim-viewer",
  "keywords": [
    "prim",
    "prim-viewer",
    "show-prim",
    "webmcp",
    "react",
    "next"
  ]
}
